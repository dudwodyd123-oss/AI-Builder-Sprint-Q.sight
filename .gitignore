# ── 비밀 값 ─────────────────────────────────────────────
# API 키가 들어가는 파일. 절대 커밋하지 말 것.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ── 런타임 생성물 ────────────────────────────────────────
# 모금 사업 · 이행 · 리포트 등 실행 중 만들어지는 로컬 저장소
backend/data/*.json
backend/data/uploads/

# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ── Node ────────────────────────────────────────────────
node_modules/
dist/
build/

# ── OS · 편집기 ──────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
