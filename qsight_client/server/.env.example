# === Upstage AI (챗봇) ===
# https://console.upstage.ai 에서 발급받은 API Key
UPSTAGE_API_KEY=up_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_MODEL=solar-pro2

# === 기업용 웹 서버 ===
# 사업 목록, 계약 항목 스키마, 약정 생성(서명 요청 메일 발송), 서명 상태 조회를 담당합니다.
# 모두싸인 API 키는 이 서버에만 있고, 개인용 웹은 모두싸인을 직접 호출하지 않습니다.
QSIGHT_CORP_API=http://localhost:8080

# === 모두싸인 (개인 계정 — 조회 전용) ===
# 기부자 본인이 자기가 서명한 문서를 증서함에서 보기 위한 키입니다.
# ⚠️ 기업용 서버가 쓰는 기관 계정 키와 반드시 다른 계정이어야 합니다.
#    개인용 웹은 문서를 만들거나 서명을 요청하지 않고, 조회만 합니다.
# 비워두면 증서함의 문서 목록만 비활성화되고 나머지 기능은 정상 동작합니다.
MODUSIGN_EMAIL=
MODUSIGN_API_KEY=
MODUSIGN_BASE_URL=https://api.modusign.co.kr

# === 서버 ===
PORT=4000
