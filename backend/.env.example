# ── 기관 정보 ───────────────────────────────────────────────
ORG_NAME=부산문화유산지킴이
ORG_MANAGER=김이레

# ── 모두싸인 API ────────────────────────────────────────────
# 모두싸인 웹 > 설정 > API 에서 발급받은 값.
# 둘 다 비어 있으면 자동으로 mock 모드(데모 데이터)로 동작한다.
MODUSIGN_API_BASE=https://api.modusign.co.kr
MODUSIGN_EMAIL=
MODUSIGN_API_KEY=
# 키가 있어도 강제로 데모 데이터를 쓰고 싶으면 1
MODUSIGN_FORCE_MOCK=0

# ── Upstage API (W5 서식 파싱 / W7 공고문 자동 채우기 / W8 증빙 추출 / 개인용 챗봇) ──
UPSTAGE_API_KEY=
UPSTAGE_SOLAR_MODEL=solar-pro2

# ── 서버 ────────────────────────────────────────────────────
PORT=8080
# 정적 웹 폴더. 비워두면 backend/web → 없으면 ../frontend 순으로 찾는다.
WEB_DIR=
