# === Upstage AI (챗봇) ===
# https://console.upstage.ai 에서 발급받은 API Key (up_ 로 시작합니다)
# 비워두면 /api/health 가 upstage:off 로 표시되고, 챗봇 상담만 사용할 수 없습니다.
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_MODEL=solar-pro2

# === 기업용 웹 서버 ===
# 사업 목록, 계약 항목 스키마, 약정 생성(서명 요청 메일 발송), 서명 상태 조회를 담당합니다.
# 모두싸인 API 키는 이 서버에만 있고, 개인용 웹은 모두싸인을 직접 호출하지 않습니다.
QSIGHT_CORP_API=http://localhost:8080

# === 모두싸인 (개인 계정 — 조회 전용) ===
# 기부자 본인이 자기가 서명한 문서를 증서함에서 보기 위한 키입니다.
# ⚠️ 기업용 서버가 쓰는 기관 계정 키와 반드시 다른 계정이어야 합니다.
#    개인용 웹은 문서를 만들거나 서명을 요청하지 않고, 조회만 합니다.
# 비워두면 증서함의 문서 목록만 비활성화되고 나머지 기능은 정상 동작합니다.
MODUSIGN_EMAIL=
MODUSIGN_API_KEY=
MODUSIGN_BASE_URL=https://api.modusign.co.kr

# === 문화유산 실시간 연동 ===
# 두 가지 방식을 모두 지원합니다. HERITAGE_API_URL만 채우면 바로 켜집니다
# (레거시 API는 서비스키가 필요 없어서 HERITAGE_SERVICE_KEY는 비워둬도 됩니다).
#
#  A) 국가유산청 레거시 무료 API (서비스키 불필요, XML 응답) — 실제로 브라우저에서
#     테스트해 정상 동작을 확인한 방식입니다:
#       http://www.cha.go.kr/cha/SearchKindOpenapiList.do?pageUnit=20&pageIndex=1&ccbaCtcd=11&ccbaLcto=&ccbaKdcd=
#     파라미터:
#       - ccbaCtcd  : 시도 코드 (예: 11=서울, 26=부산, 21=인천, 41=경기 ...)
#       - ccbaLcto  : 시군구 코드. 아래 조회 API로 특정 ccbaCtcd에 속한 구/군 코드 목록을
#                     먼저 가져올 수 있습니다 (비워두면 시도 전체):
#                       http://www.cha.go.kr/cha/SearchLctoOpenapi.do?ccbaCtcd=11
#       - ccbaKdcd  : 문화재 종목 코드 (비워두면 전체 종목)
#       - pageUnit / pageIndex : 페이지당 개수 / 페이지 번호
#     이 API는 www.cha.go.kr 대신 www.khs.go.kr(국가유산청 새 도메인)로도 동작할 수 있습니다.
#
#  B) data.go.kr에 등록된 정식 Open API (서비스키 필요) — https://www.data.go.kr 에서
#     "국가유산청"으로 검색해 원하는 데이터셋의 활용신청을 하면 서비스키를 받을 수 있고,
#     상세페이지의 "미리보기/샘플 URL"을 HERITAGE_API_URL에 그대로 붙여넣으면 됩니다.
#
# 응답이 JSON이든 XML이든 서버가 자동으로 감지해 파싱합니다.
# 비워두면 /api/health 가 heritage:static 으로 표시되고, 화면엔 정적 목록이 나옵니다.
HERITAGE_SERVICE_KEY=
HERITAGE_API_URL=

# === 고향사랑기부 답례품 연동 ===
# ⚠️ 고향사랑e음, busanlove.kr 모두 공개 Open API가 없습니다. 그래서 두 가지 방법 중
#    하나를 선택해서 씁니다 (둘 다 비우면 서버에 미리 담아둔 샘플 데이터로 표시됩니다):
#
#  A) 팀에서 직접 운영하는 JSON API가 있다면 그 주소를 아래에 적습니다.
HOMETOWN_REWARDS_SOURCE_URL=
#  B) 사람이 직접 관리하는 JSON 파일 경로 (server/data/hometown-rewards.sample.json 을
#     복사해서 최신 답례품으로 채워넣고, 그 파일 경로를 적어주세요). 서버 재배포 없이
#     파일만 저장하면 다음 요청부터 반영됩니다 (최대 10분 캐시).
HOMETOWN_REWARDS_LOCAL_FILE=

# === 서버 ===
PORT=4000
